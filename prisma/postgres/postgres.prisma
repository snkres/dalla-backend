generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/prisma/client/postgres"
}

datasource db {
  provider          = "postgresql"
  url               = env("POSTGRES_DATABASE_URL")
  shadowDatabaseUrl = env("PG_SHADOW_DATABASE")
}

model User {
  id          String       @id
  name        String
  username    String
  email       String
  password    String
  UserProfile UserProfile?
  onboarded   Boolean      @default(false)
  verified    Boolean      @default(false)
  suspended   Boolean      @default(false)
  projects    Project[]
  proposals   Proposal[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([email, id, username])
  @@index([email])
}

model Company {
  id        String  @id
  name      String
  email     String
  domain    String?
  password  String
  onboarded Boolean @default(false)
  suspended Boolean @default(false)
  verified  Boolean @default(false)

  CompanyProfile CompanyProfile?
  projects       Project[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([id, email, domain])
  @@index([email, domain])
}

model CompanyProfile {
  id               String   @id
  companyId        String
  location         String?
  areas            Json[]
  goals            Json[]
  targetIndustries Json[]
  website          String?
  meta             Json? // will include phone, social media links, company size, company type, company logo
  headline         String?
  bio              String?
  logo             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  Company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId])
}

model UserProfile {
  id         String           @id
  userId     String
  headline   String
  gender     Gender?
  bio        String?
  avatar     String
  meta       Json? // will include phone, location, years of exprerience, skills, website link
  resume     String?
  precentage Float?           @default(20)
  experience UserExperience[]
  education  UserEducation[]
  projects   UserProject[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  User User @relation(fields: [userId], references: [id])

  @@unique([userId])
}

model UserExperience {
  id        String   @id
  profileId String
  title     String
  company   String
  location  String
  meta      Json? // will include skills, responsibilities, achievements, type of employment
  startDate String
  endDate   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  UserProfile UserProfile @relation(fields: [profileId], references: [id])
}

model UserEducation {
  id          String   @id
  profileId   String
  school      String
  degree      String
  field       String
  startDate   String
  endDate     String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  UserProfile UserProfile @relation(fields: [profileId], references: [id])
}

model UserProject {
  id          String   @id
  profileId   String
  title       String
  role        String
  description String
  skills      String[]
  thumbnail   String
  link        String
  media       String[]

  UserProfile UserProfile @relation(fields: [profileId], references: [id])
  Proposals   Proposal[]
}

model Project {
  id                     String        @id
  title                  String
  description            String
  scope                  String
  jobTitle               String?
  skills                 String[]
  deliverables           String?
  meta                   Json? // will include project type, project size, project budget, project deadline
  approved               Boolean       @default(true)
  status                 ProjectStatus @default(Open)
  companyId              String
  assignedProfessionalId String?
  proposals              Proposal[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  deletedAt              DateTime?

  company      Company @relation(fields: [companyId], references: [id])
  professional User?   @relation(fields: [assignedProfessionalId], references: [id])
}

model Proposal {
  id               String        @id
  projectId        String
  professionalId   String
  description      String
  price            Float
  timeline         String
  media            String[]
  relevantProjects UserProject[]

  status    ProposalStatus @default(Pending)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  project      Project @relation(fields: [projectId], references: [id])
  professional User    @relation(fields: [professionalId], references: [id])
}

enum ProjectStatus {
  Open
  Closed
  InProgress
  Completed
}

enum ProposalStatus {
  Pending
  Accepted
  Rejected
}

enum Gender {
  Male
  Female
}
